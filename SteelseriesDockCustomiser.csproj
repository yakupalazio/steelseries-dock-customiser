<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.0</Version>
    <Product>Steelseries Dock Customiser</Product>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup><None Update="PixelOperator.ttf" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <None Update="dock-photo-local.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>